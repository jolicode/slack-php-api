{
    "name": "jolicode/slack-php-api",
    "description": "An up to date PHP client for Slack's API",
    "keywords": ["slack", "slackapi", "api", "client", "openapi", "swagger", "sdk"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Loïck Piera",
            "email": "pyrech@gmail.com"
        },
        {
            "name": "JoliCode",
            "email": "coucou@jolicode.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "JoliCode\\Slack\\Api\\": "generated/",
            "JoliCode\\Slack\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JoliCode\\Slack\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "jane-php/open-api-runtime": "^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "jane-php/open-api-2": "^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "friendsofphp/php-cs-fixer": "^3.2.2",
        "symfony/phpunit-bridge": "^6.0 || ^7.0 || ^8.0",
        "opis/json-schema": "^1.0",
        "symfony/console": "^6.0 || ^7.0 || ^8.0",
        "symfony/process": "^6.0 || ^7.0 || ^8.0"
    },
    "config": {}
}
